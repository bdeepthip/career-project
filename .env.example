# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database. Leave unset on your laptop: GAJ uses database.db (SQLite).
# In production, set it to your PostgreSQL address:
# DATABASE_URL=postgresql://user:password@host:5432/jobtrack

# "production" on a public server; leave unset on your laptop
# FLASK_ENV=production

# Optional: Gmail sync, for the account whose email matches EMAIL_ADDRESS only
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=your16charapppassword
# IMAP_FOLDER=GAJ

# Optional: real email for password reset links.
# Leave MAIL_SERVER empty on your laptop: reset links print in the terminal.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM=GAJ <you@gmail.com>

# Optional: per-user forwarding addresses (jt-xxxx@INBOUND_DOMAIN).
# An email service (Cloudflare Email Routing, Postmark, Mailgun, SendGrid)
# posts incoming mail to https://your-site/inbound/email with this secret.
# Leave INBOUND_WEBHOOK_SECRET empty to keep it switched off.
# INBOUND_DOMAIN=in.yourdomain.com
# INBOUND_WEBHOOK_SECRET=another-long-random-string

# Public launch extras (see LAUNCH.md)
# CONTACT_EMAIL=hello@yourdomain.com        # shown on Privacy/Terms pages
# FEEDBACK_URL=https://forms.gle/...        # "Send feedback" link in the footer
# BETA_INVITE_CODE=temple-beta              # only people with this code can sign up
