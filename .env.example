# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# "production" on a public server; leave unset on your laptop
# FLASK_ENV=production

# Optional: Gmail sync, for the account whose email matches EMAIL_ADDRESS only
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=your16charapppassword
# IMAP_FOLDER=JobTrack

# Optional: real email for password reset links.
# Leave MAIL_SERVER empty on your laptop: reset links print in the terminal.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_FROM=JobTrack <you@gmail.com>
