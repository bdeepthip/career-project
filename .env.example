# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# "production" on a public server; leave unset on your laptop
# FLASK_ENV=production

# Optional: Gmail sync, for the account whose email matches EMAIL_ADDRESS only
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=your16charapppassword
# IMAP_FOLDER=JobTrack
